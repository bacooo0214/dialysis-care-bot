# ==========================================
# 洗腎照護 LINE Bot 環境變數設定範本
# ==========================================

# 1. LINE Messaging API
# 至 LINE Developers Console -> Messaging API 取得
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 2. Google Gemini API
# 至 Google AI Studio (aistudio.google.com) 取得
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Supabase 設定
SUPABASE_URL=https://anarjmhbhimpaxvavjiz.supabase.co
# 請至 Supabase Dashboard (Project Settings -> API) 複製 service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
STORAGE_BUCKET=media
SIGNED_URL_TTL_SECONDS=31536000

# 4. Google Sheets 備份 (選填)
# 若需備份至 Google Sheets，請提供 Google Cloud 服務帳戶 JSON 內容或檔案路徑
GOOGLE_SERVICE_ACCOUNT_JSON=

# 5. 排程端點金鑰 (Cloud Scheduler 呼叫用)
CRON_SECRET=dialysis-care-secret-key-2026

# 6. 其他配置
TIMEZONE=Asia/Taipei
LOG_LEVEL=INFO
STORE_ORIGINAL_IMAGES=false
GROUP_AUTO_DETECT_REPORTS=true
